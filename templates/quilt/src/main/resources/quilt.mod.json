{
  "schema_version": 1,
  "quilt_loader": {
    "group": "{{group}}",
    "id": "{{mod_id}}",
    "version": "${version}",
    "metadata": {
      "name": "{{mod_name}}",
      "description": "{{description}}",
      "contributors": {
        "{{author}}": "owner"
      },
      "license": "{{license}}"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "init": [
        "{{package}}.{{mod_class}}"
      ]
    },
    "depends": [
      {
        "id": "quilt_loader",
        "versions": ">=0.26.0"
      },
      {
        "id": "minecraft",
        "versions": "~{{mc_version}}"
      }
    ]
  }
}